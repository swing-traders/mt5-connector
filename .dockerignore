# The MT5 server image (mt5server/Dockerfile) is built from the repository root and takes only
# what it copies.
*
!mt5connect/__init__.py
!mt5connect/mirror.py
!mt5connect/history_wire.py
!mt5server/
mt5server/**/__pycache__
mt5server/compile_commands.json
mt5server/mt5ticks/.cache
mt5server/mt5ticks/.clangd
mt5server/mt5ticks/.clang-format
mt5server/mt5ticks/.vscode
mt5server/mt5ticks/.mql-auto-forwards
mt5server/mt5ticks/compile_commands.json
mt5server/mt5ticks/**/ticks.ex5
