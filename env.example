# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────
 
MT5_ACCOUNT=12345678
 
MT5_PASSWORD=your_password_here
 
MT5_SERVER=Exness-MT5Trial9

# Comma-separated list of symbols (exact names from MT5 Market Watch)
# Exness standard demo accounts use the 'm' suffix
MT5_SYMBOLS=EURUSDm,XAUUSDm

# The MT5 server's HTTP API; its WebSocket tick hub is derived on port 9000
MT5_SERVER_URL=http://127.0.0.1:5000

# Note: the container streams ONLY the symbols listed here
# (each needs a chart+EA inside the container). Symbols the adapter
# subscribes to but are NOT in MT5_SYMBOLS will produce no ticks.

# Optional overrides (safe to leave as defaults)
MT5_EXEC_POLL_INTERVAL_MS=250
